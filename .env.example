NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mukesh_portfolio
# Generate privately with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_ORIGIN=http://127.0.0.1:5173
STORAGE_DRIVER=local
# Production: absolute path on a backed-up persistent volume.
UPLOAD_DIR=./uploads
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
